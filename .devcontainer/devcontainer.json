{
  "name": "ICS3U CodeHS JavaScript",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Dice Duel",
      "onAutoForward": "openBrowser"
    }
  },
  "postAttachCommand": "python3 -m http.server 8080",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "program.js"]
    }
  }
}
